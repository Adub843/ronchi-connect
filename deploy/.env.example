# Copy to .env and fill in. Never commit the real .env file.

# The address customers and the app use, e.g. connect.ronchiamerica.com
# Its DNS "A" record must point at this server before starting.
DOMAIN=connect.example.com

# This server's public IPv4 address (shown in your hosting control panel).
PUBLIC_IP=203.0.113.10

# First administrator account, created on first start only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Shared secret between the server and the relay. Generate with:  openssl rand -hex 32
TURN_SECRET=
